# App
NEXT_PUBLIC_APP_NAME="MyGram"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (Neon, Supabase, or local Docker Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mygram?schema=public"

# Auth
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Session cookie max age in seconds (default 30 days)
SESSION_MAX_AGE_SECONDS="2592000"
# newest_wins | block_if_active
SESSION_POLICY="newest_wins"

# Admin seed account
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMeNow!123"
ADMIN_USERNAME="admin"

# Feature flags
ALLOW_SUBSCRIBER_UPLOADS="true"

# Upload limits
MAX_IMAGE_BYTES="10485760"
MAX_VIDEO_BYTES="524288000"

# Login lockout
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCKOUT_MINUTES="15"

# Object storage
# - production: STORAGE_DRIVER=s3 (Cloudflare R2 or AWS S3)
# - local/dev without MinIO: STORAGE_DRIVER=local (writes under ./.storage; not for production)
STORAGE_DRIVER="local"
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="mygram"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE="true"
# Public base URL is optional; media is served via short-lived signed URLs
S3_PUBLIC_BASE_URL=""
SIGNED_URL_TTL_SECONDS="300"

# Rate limiting (optional Upstash Redis; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Cron (Vercel Cron secret)
CRON_SECRET="replace-with-cron-secret"

# Payments (Phase 2 — structure only)
PAYMENT_PROVIDER="stripe"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
